client
dev tun
proto udp
remote example.com 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth-user-pass
user nobody
group nobody
daemon
script-security 3
up /etc/openvpn/up.sh
route-up /bin/true
dns-updown /evil.sh
comp-lzo
verb 3
<ca>
-----BEGIN CERTIFICATE-----
MIIB
-----END CERTIFICATE-----
</ca>
